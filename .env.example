# SERVER-ONLY SECRETS — NEVER prefix any of these with NEXT_PUBLIC_
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# >= 32 random chars (openssl rand -hex 32). REQUIRED in production, app must refuse to start without it.
AUTH_SECRET=""
ADMIN_BOOTSTRAP_PASSWORD=""

# Optional Supabase backend sync (server-side only)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional: allow framing (e.g. AI Studio preview). Leave empty in production.
FRAME_ANCESTORS=""

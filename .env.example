# SERVER-ONLY SECRETS — NEVER prefix any of these with NEXT_PUBLIC_
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# >= 32 random chars (openssl rand -hex 32). REQUIRED in production, app must refuse to start without it.
AUTH_SECRET=""
ADMIN_BOOTSTRAP_PASSWORD=""
FACTORY_RESET_PASSWORD=""

# Optional Supabase backend sync (server-side only)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
RESEND_API_KEY=""

# Optional: extra space-separated HTTPS origins allowed to frame the app (e.g. https://example.com)
FRAME_ANCESTORS=""

# Optional server binding configuration (defaults to 0.0.0.0:3000)
HOSTNAME="0.0.0.0"
PORT="3000"
